<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include essential user databases, preferences, and portable backups -->
        <include domain="database" path="vybe_music.db" />
        <include domain="sharedpref" path="vybe_playback_state.xml" />
        <include domain="file" path="sync_storage/vybe_backup.json" />
        <!-- Exclude large and volatile disk caches -->
        <exclude domain="root" path="cache" />
    </cloud-backup>
    <device-transfer>
        <!-- Transfer all user playlists, history, and favorites between devices -->
        <include domain="database" path="vybe_music.db" />
        <include domain="sharedpref" path="vybe_playback_state.xml" />
        <include domain="file" path="sync_storage/vybe_backup.json" />
        <exclude domain="root" path="cache" />
    </device-transfer>
</data-extraction-rules>
